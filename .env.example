# Recommended on Render Free: Resend HTTPS API (SMTP ports are blocked there).
# Verify your sender domain in Resend and set these as private environment variables.
RESEND_API_KEY=re_replace-with-your-resend-api-key
RESEND_FROM_EMAIL=AlphaMetrics <verify@tarndynamics.com>

# Optional SMTP fallback for local development or hosting that allows SMTP.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USERNAME=resend
# SMTP_PASSWORD=re_replace-with-your-resend-api-key
# SMTP_FROM_EMAIL=AlphaMetrics <verify@tarndynamics.com>
# SMTP_USE_SSL=true

# Optional database connection. Leave unset to use the local SQLite database.
# DATABASE_URL=postgresql://user:password@host:5432/alphametrics
